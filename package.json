{
  "name": "llm-gateway-workspace",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint .",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --parallel exec tsc --noEmit",
    "test": "pnpm -r --parallel test",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "eslint": "^9.13.0",
    "typescript-eslint": "^8.11.0",
    "prettier": "^3.3.0",
    "@types/node": "^22.8.0"
  }
}
